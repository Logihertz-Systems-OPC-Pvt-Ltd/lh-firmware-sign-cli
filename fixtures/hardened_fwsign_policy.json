{
  "policy_name": "hardened_sovereign_fwsign_policy",
  "allow_pkcs1v15_padding": false,
  "allow_sha1_or_md5": false,
  "min_rsa_key_bits": 3072,
  "require_pkcs11_hsm": true,
  "enforce_cka_sensitive": true,
  "enforce_cka_non_extractable": true,
  "require_rfc3161_timestamp": true,
  "enforce_codesigning_eku": true,
  "bind_svn_in_signature": true,
  "bind_hw_compat_id": true,
  "allow_pin_via_cli_argv": false,
  "hsm_max_pin_retries": 3,
  "require_m_of_n_quorum": true,
  "min_quorum_approvers": 2,
  "check_cert_revocation": true,
  "max_leaf_cert_validity_days": 365,
  "rsa_pss_salt_equals_hash": true,
  "hybrid_dual_signature_enabled": true,
  "auto_logout_hsm_session": true,
  "hsm_session_timeout_sec": 30,
  "transparency_log_receipt_enabled": true
}
