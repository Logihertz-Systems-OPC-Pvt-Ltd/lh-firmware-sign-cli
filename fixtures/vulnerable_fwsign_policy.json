{
  "policy_name": "vulnerable_legacy_fwsign_policy",
  "allow_pkcs1v15_padding": true,
  "allow_sha1_or_md5": true,
  "min_rsa_key_bits": 2048,
  "require_pkcs11_hsm": false,
  "enforce_cka_sensitive": false,
  "enforce_cka_non_extractable": false,
  "require_rfc3161_timestamp": false,
  "enforce_codesigning_eku": false,
  "bind_svn_in_signature": false,
  "bind_hw_compat_id": false,
  "allow_pin_via_cli_argv": true,
  "hsm_max_pin_retries": 10,
  "require_m_of_n_quorum": false,
  "min_quorum_approvers": 1,
  "check_cert_revocation": false,
  "max_leaf_cert_validity_days": 730,
  "rsa_pss_salt_equals_hash": false,
  "hybrid_dual_signature_enabled": false,
  "auto_logout_hsm_session": false,
  "hsm_session_timeout_sec": 300,
  "transparency_log_receipt_enabled": false
}
